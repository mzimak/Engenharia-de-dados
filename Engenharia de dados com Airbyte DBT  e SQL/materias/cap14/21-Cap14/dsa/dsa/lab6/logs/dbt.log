    create view main."clientes" as
      -- Configura o modelo para ser materializado como uma "view" no banco de dados
                                   -- Não é uma view materializada e sim um consulta armazenada ( código sql)
WITH clientes_base AS (  -- Criação de uma CTE (Common Table Expression) chamada "clientes_base"
